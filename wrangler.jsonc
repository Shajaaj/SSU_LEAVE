{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssleave",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "ss-leave-management"
  }
}
